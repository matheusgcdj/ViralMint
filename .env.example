# ── Aplicação ─────────────────────────────────────────────
# Ambas as chaves são geradas automaticamente na primeira execução se deixadas em branco.
SECRET_KEY=
ENCRYPTION_KEY=
DEBUG=false

# Para deploy no Coolify / Docker, mantenha HOST=0.0.0.0
HOST=0.0.0.0
PORT=16888
VIRALMINT_NO_BROWSER=1

# ── Provedor de IA (BYOK — Configure UM deles) ───────────
# Usado pelo chat planner, agente de análise e gerador de roteiros.
# Também pode ser configurado diretamente na interface em Configurações.
#
# OpenRouter é uma excelente opção única para Claude, GPT-4o, Gemini, DeepSeek, etc.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Ou qualquer servidor compatível com a API da OpenAI (Ollama, LM Studio, vLLM, llama.cpp):
# Os modelos disponíveis são detectados automaticamente quando você configura o Base URL.
# Exemplo para Ollama local ou na rede do Coolify:
#   CUSTOM_AI_BASE_URL=http://ollama:11434/v1
#   CUSTOM_AI_MODEL=qwen2.5:14b
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=

# ── Transcrição via Groq (Opcional) ──
# Groq roda Whisper large-v3 ~10× mais rápido que tempo real.
# Free tier tem minutos generosos por dia. Se configurado, aparece como
# opção "Groq" ao lado do Whisper local na transcrição.
GROQ_API_KEY=

# ── Google Cloud TTS (Opcional) ──
# Vozes neurais de alta qualidade com tier gratuito generoso (1M chars/mês
# grátis em Standard + 1M em WaveNet). Para usar via API key simples:
GOOGLE_TTS_API_KEY=
#
# 🔑 POOL DE CONTAS: Se você tem múltiplas contas Google, coloque todas as
# API keys separadas por vírgula para SOMAR os créditos gratuitos.
# Exemplo: 7 contas × 1M chars/mês = 7M chars/mês grátis!
# O sistema faz round-robin automático e failover quando uma key atinge quota.
GOOGLE_TTS_API_KEYS=
# Exemplo: GOOGLE_TTS_API_KEYS=AIzaSy..key1,AIzaSy..key2,AIzaSy..key3
#
# Ou via Service Account: exporte GOOGLE_APPLICATION_CREDENTIALS=/caminho/para/sa.json

# ── Scout (Opcional) ──
# Chave da API do YouTube para busca de vídeos em alta no Scout
YOUTUBE_API_KEY=
TIKHUB_API_KEY=

# ── Vídeos de Estoque (Pexels / Pixabay para Smart Video) ──
# Recomendado cadastrar ao menos uma chave gratuita do Pexels ou Pixabay
PEXELS_API_KEY=
PIXABAY_API_KEY=
# auto (padrão testa Pexels e depois Pixabay), ou force: pexels | pixabay
STOCK_MEDIA_PROVIDER=auto

# ── Integrações de Upload (Opcionais) ──
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:16888/api/settings/youtube-callback

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:16888/api/settings/tiktok-upload-callback
