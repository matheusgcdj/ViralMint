# ── Aplicação ─────────────────────────────────────────────
# Ambas as chaves são geradas automaticamente na primeira execução se deixadas em branco.
SECRET_KEY=
ENCRYPTION_KEY=
DEBUG=false

# Para deploy no Coolify / Docker, mantenha HOST=0.0.0.0
HOST=0.0.0.0
PORT=16888
VIRALMINT_NO_BROWSER=1

# ── Provedor de IA (BYOK — Configure UM deles) ───────────
# Usado pelo chat planner, agente de análise e gerador de roteiros.
# Também pode ser configurado diretamente na interface em Configurações.
#
# OpenRouter é uma excelente opção única para Claude, GPT-4o, Gemini, DeepSeek, etc.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Ou qualquer servidor compatível com a API da OpenAI (Ollama, LM Studio, vLLM, llama.cpp):
# Exemplo para Ollama local ou na rede do Coolify:
#   CUSTOM_AI_BASE_URL=http://ollama:11434/v1
#   CUSTOM_AI_MODEL=qwen2.5:14b
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=

# ── Scout (Opcional) ──
# Chave da API do YouTube para busca de vídeos em alta no Scout
YOUTUBE_API_KEY=
TIKHUB_API_KEY=

# ── Vídeos de Estoque (Pexels / Pixabay para Smart Video) ──
# Recomendado cadastrar ao menos uma chave gratuita do Pexels ou Pixabay
PEXELS_API_KEY=
PIXABAY_API_KEY=
# auto (padrão testa Pexels e depois Pixabay), ou force: pexels | pixabay
STOCK_MEDIA_PROVIDER=auto

# ── Integrações de Upload (Opcionais) ──
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:16888/api/settings/youtube-callback

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:16888/api/settings/tiktok-upload-callback
